      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.mikhailvolvachvarfolomeev.diplom"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "0c01af44-953a-4335-aae4-96d6c6b003b1"
      }
    }
  }
}
